{
  "name": "xlt-workbench",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "AI 用量看板 — 统一查看各平台订阅额度与 Token 使用情况",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:diagnostic": "vue-tsc --noEmit && vite build --mode diagnostic",
    "test:diagnostic": "pnpm exec tsx scripts/smoke-diagnostic.mts",
    "tauri:build:diagnostic": "node scripts/build-diagnostic.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "pnpm exec tsx scripts/smoke-data.mts && pnpm exec tsx scripts/smoke-ark-mapping.mts && pnpm exec tsx scripts/smoke-subscriptions.mts && pnpm exec tsx scripts/smoke-token-estimate.mts && pnpm exec tsx scripts/smoke-pricing.mts && pnpm exec tsx scripts/smoke-vault-crypto.mts && pnpm exec tsx scripts/smoke-oil.mts && pnpm exec tsx scripts/smoke-clipboard-content.mts && pnpm exec tsx scripts/smoke-feature-gates.mts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test": "pnpm typecheck && pnpm test:unit && pnpm test:e2e",
    "tauri": "tauri",
    "tauri:dev": "pnpm tauri dev",
    "tauri:build": "pnpm tauri build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@internationalized/date": "^3.12.4",
    "@lobehub/icons-static-svg": "^1.95.0",
    "@nuxt/ui": "^4.10.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "echarts": "^5.5.1",
    "js-tiktoken": "^1.0.21",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^15.0.2",
    "md-editor-v3": "^6.5.6",
    "pinia": "^2.2.6",
    "reka-ui": "^2.10.4",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.13",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.18",
    "@iconify-json/simple-icons": "^1.2.20",
    "@qoder-ai/qoder-agent-sdk": "^1.0.34",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/markdown-it": "^14.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0",
    "zod": "^4.5.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@qoder-ai/qoder-agent-sdk",
      "esbuild",
      "vue-demi"
    ]
  }
}
