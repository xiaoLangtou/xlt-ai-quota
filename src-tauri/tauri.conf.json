{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI 用量看板",
  "version": "0.1.3",
  "identifier": "com.xlt.workbench",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI 用量看板",
        "width": 1400,
        "height": 940,
        "minWidth": 940,
        "minHeight": 720,
        "visible": false,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
 "bundle": {
  "active": true,
  "targets": "all",
  "category": "DeveloperTool",
  "icon": [
    "icons/32x32.png",
    "icons/128x128.png",
    "icons/128x128@2x.png",
    "icons/icon.icns",
    "icons/icon.ico"
  ]
}

}
