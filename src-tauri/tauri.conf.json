{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI 用量看板",
  "version": "0.1.3",
  "identifier": "com.xlt.workbench",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "AI 用量看板",
        "width": 1160,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "tray-panel",
        "url": "tray-panel.html",
        "title": "AI 用量",
        "width": 336,
        "height": 360,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true,
        "focus": false,
        "windowEffects": {
          "effects": ["popover"],
          "state": "active",
          "radius": 14
        }
      },
      {
        "label": "clipboard-panel",
        "url": "clipboard-panel.html",
        "title": "剪贴板历史",
        "width": 868,
        "height": 608,
        "center": true,
        "minWidth": 668,
        "minHeight": 508,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
 "bundle": {
  "active": true,
  "targets": "all",
  "category": "DeveloperTool",
  "icon": [
    "icons/32x32.png",
    "icons/128x128.png",
    "icons/128x128@2x.png",
    "icons/icon.icns",
    "icons/icon.ico"
  ]
}

}
